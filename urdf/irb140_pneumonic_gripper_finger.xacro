            </geometry>
        </collision>
    </link>
    
    <!-- Joints -->
    <joint name="link_1_to_link_2" type="revolute">
        <parent link="link_1"/>
        <child link="link_2"/>

        <!-- joint origin -->
        <origin xyz="0 0 0/" rpy="0 0 0"/>
        
        <axis xyz="0 1 0"/>

        <limit lower="-0.0524" upper="0" effort="10" velocity="1.0"/>
    </joint>

    <joint name="link_2_to_link_3" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>

