        <mesh filename="package://abb_irb140_description/meshes/abb_irb140_pneumonic_end_effector/visual/finger_visual/visual/link_3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="offwhite"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://abb_irb140_description/meshes/abb_irb140_pneumonic_end_effector/visual/finger_visual/visual/link_3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.035"/>
      <mass value="0.009075"/>
      <inertia ixx="7.7213125e-07" ixy="0.0" ixz="0.0" iyy="5.641625000000001e-07" iyz="0.0" izz="1.15328125e-06"/>
    </inertial>
  </link>
  <link name="pneumatic_gripper_right_link_4">
    <visual>
      <geometry>
        <mesh filename="package://abb_irb140_description/meshes/abb_irb140_pneumonic_end_effector/visual/finger_visual/visual/link_4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="offwhite"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://abb_irb140_description/meshes/abb_irb140_pneumonic_end_effector/visual/finger_visual/visual/link_4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.055"/>
      <mass value="0.009075"/>
      <inertia ixx="7.7213125e-07" ixy="0.0" ixz="0.0" iyy="5.641625000000001e-07" iyz="0.0" izz="1.15328125e-06"/>
    </inertial>
  </link>
  <link name="pneumatic_gripper_right_link_5">
    <visual>
      <geometry>
        <mesh filename="package://abb_irb140_description/meshes/abb_irb140_pneumonic_end_effector/visual/finger_visual/visual/link_5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="offwhite"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://abb_irb140_description/meshes/abb_irb140_pneumonic_end_effector/visual/finger_visual/visual/link_5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.065"/>
      <mass value="0.009075"/>
      <inertia ixx="7.7213125e-07" ixy="0.0" ixz="0.0" iyy="5.641625000000001e-07" iyz="0.0" izz="1.15328125e-06"/>
    </inertial>
  </link>
  <link name="pneumatic_gripper_right_link_6">
    <visual>
      <geometry>
        <mesh filename="package://abb_irb140_description/meshes/abb_irb140_pneumonic_end_effector/visual/finger_visual/visual/link_6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="offwhite"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://abb_irb140_description/meshes/abb_irb140_pneumonic_end_effector/visual/finger_visual/visual/link_6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.075"/>
      <mass value="0.009075"/>
      <inertia ixx="7.7213125e-07" ixy="0.0" ixz="0.0" iyy="5.641625000000001e-07" iyz="0.0" izz="1.15328125e-06"/>
    </inertial>
  </link>
  <link name="pneumatic_gripper_right_link_7">
    <visual>
      <geometry>
        <mesh filename="package://abb_irb140_description/meshes/abb_irb140_pneumonic_end_effector/visual/finger_visual/visual/link_7.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="offwhite"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://abb_irb140_description/meshes/abb_irb140_pneumonic_end_effector/visual/finger_visual/visual/link_7.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.085"/>
      <mass value="0.009075"/>
      <inertia ixx="7.7213125e-07" ixy="0.0" ixz="0.0" iyy="5.641625000000001e-07" iyz="0.0" izz="1.15328125e-06"/>
    </inertial>
  </link>
  <!-- Base to link_1 joint -->
  <joint name="pneumatic_gripper_right_base_to_link_1" type="fixed">
    <parent link="pneumatic_gripper_base_link"/>
    <child link="pneumatic_gripper_right_link_1"/>
    <origin rpy="0.0 0.0 -1.57" xyz="-0.008 -0.046 0.0071"/>
  </joint>
  <!-- Joints between links -->
  <joint name="pneumatic_gripper_right_link_1_to_link_2" type="revolute">
    <parent link="pneumatic_gripper_right_link_1"/>
    <child link="pneumatic_gripper_right_link_2"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-0.09" upper="0" velocity="1.0"/>
    <dynamics damping="0.1"/>
    <mimic joint="pneumatic_gripper_left_link_1_to_link_2" multiplier="1.0" offset="0.0"/>
  </joint>
  <joint name="pneumatic_gripper_right_link_2_to_link_3" type="revolute">
    <parent link="pneumatic_gripper_right_link_2"/>
    <child link="pneumatic_gripper_right_link_3"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-0.09" upper="0" velocity="1.0"/>
    <dynamics damping="0.1"/>
    <mimic joint="pneumatic_gripper_left_link_1_to_link_2" multiplier="1.0" offset="0.0"/>
  </joint>
  <joint name="pneumatic_gripper_right_link_3_to_link_4" type="revolute">
    <parent link="pneumatic_gripper_right_link_3"/>
    <child link="pneumatic_gripper_right_link_4"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-0.09" upper="0" velocity="1.0"/>
    <dynamics damping="0.1"/>
    <mimic joint="pneumatic_gripper_left_link_1_to_link_2" multiplier="1.0" offset="0.0"/>
  </joint>
  <joint name="pneumatic_gripper_right_link_4_to_link_5" type="revolute">
    <parent link="pneumatic_gripper_right_link_4"/>
    <child link="pneumatic_gripper_right_link_5"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-0.09" upper="0" velocity="1.0"/>
    <dynamics damping="0.1"/>
    <mimic joint="pneumatic_gripper_left_link_1_to_link_2" multiplier="1.0" offset="0.0"/>
  </joint>
  <joint name="pneumatic_gripper_right_link_5_to_link_6" type="revolute">
    <parent link="pneumatic_gripper_right_link_5"/>
    <child link="pneumatic_gripper_right_link_6"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-0.09" upper="0" velocity="1.0"/>
    <dynamics damping="0.1"/>
    <mimic joint="pneumatic_gripper_left_link_1_to_link_2" multiplier="1.0" offset="0.0"/>
  </joint>
  <joint name="pneumatic_gripper_right_link_6_to_link_7" type="revolute">
    <parent link="pneumatic_gripper_right_link_6"/>
    <child link="pneumatic_gripper_right_link_7"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-0.09" upper="0" velocity="1.0"/>
    <dynamics damping="0.1"/>
    <mimic joint="pneumatic_gripper_left_link_1_to_link_2" multiplier="1.0" offset="0.0"/>
  </joint>
  <!-- Geometry-less sensor frame: the physical camera is already
             sculpted into the base_link visual mesh, so this link carries no
             visual/collision of its own (that would just duplicate the mesh
             as a second, floating box). It exists purely so the Gazebo
             rgbd_camera sensor below has a link to attach to, positioned and
             rotated (local +X is the gz camera view axis) to coincide with
             the real camera on the mesh, along the gripper's approach
             direction (+Z of ${name}_base_link). Tune the joint origin below
             to reframe the grasp view. -->
  <link name="depth_camera">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="pneumatic_gripper_to_depth_camera" type="fixed">
    <parent link="pneumatic_gripper_base_link"/>
    <child link="depth_camera"/>
    <origin rpy="3.14159265359 -1.57079632679 0" xyz="-0.025 0.0 0.05"/>
  </joint>
  <!-- Keep depth_camera as its own link/frame in the converted SDF
             instead of letting urdf2sdf lump it (and the sensor) back into
             link_6 through the fixed-joint chain. -->
  <gazebo reference="pneumatic_gripper_to_depth_camera">
    <preserveFixedJoint>true</preserveFixedJoint>
    <disableFixedJointLumping>true</disableFixedJointLumping>
  </gazebo>
  <!-- Standard ROS optical frame (z forward, x right, y down) relative to
             the camera body link; camera_info / point clouds are published in
             this frame. depth_camera's own +X is the gz view axis (see the
             mount joint above), so this applies the standard body->optical
             fixed rotation (roll -90, yaw -90) to actually get there;
             identity here would leave depth_camera_optical pointing the same
             way as depth_camera despite the data being genuinely
             optical-convention, which is what was skewing the RViz
             projection. -->
  <link name="depth_camera_optical"/>
  <joint name="depth_camera_to_optical" type="fixed">
    <parent link="depth_camera"/>
    <child link="depth_camera_optical"/>
    <origin rpy="-1.57079632679 0 -1.57079632679" xyz="0 0 0"/>
  </joint>
  <!-- reference="depth_camera" binds the gz-sim sensor to that link.
             worlds/robot_lab.world already loads gz-sim-sensors-system. gz
             publishes /rgbd_camera/{image,depth_image,points,camera_info};
             those are remapped to RealSense-style ROS 2 names by
             config/rgbd_bridge.yaml in launch/gazebo.launch.py. -->
  <gazebo reference="depth_camera">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>rgbd_camera</topic>
      <!-- Deliberately the non-optical frame: gz-sensors' rgbd_camera
                     generates the raw PointCloudPacked XYZ data in the sensor's
                     own body-convention axes (+X out of the lens), and never
                     rotates it into optical convention even though the image/
                     depth_image/camera_info topics correctly use
                     optical_frame_id below. Labelling /points with
                     depth_camera_optical (Z-forward) mismatches that data and
                     produces a 90-degree-skewed cloud in RViz; depth_camera
                     (X-forward, same convention the mount joint above uses)
                     matches what's actually in the message.
                     See gazebosim/gz-sensors#29 and #545 (open, unresolved
                     upstream as of Gazebo Harmonic). -->
      <gz_frame_id>depth_camera</gz_frame_id>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>15</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>15</far>
          </clip>
        </depth_camera>
        <optical_frame_id>depth_camera_optical</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>
  <!-- =================================================================== -->
  <!-- ros2_control + Gazebo Sim                                           -->
  <!-- =================================================================== -->
  <!-- ros2_control hardware for the 6 arm joints. gz_ros2_control's
       GazeboSimSystem reads/writes these interfaces straight from the gz-sim
       physics engine. command/state interfaces match config/controllers.yaml
       (arm_controller: position command; position + velocity state). -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- initial_value on the position state interface: gz_ros2_control's
         GazeboSimSystem seeds each joint here when the controller_manager
         configures (before any controller runs), so the arm spawns in this
         ready pose instead of the all-zero pose. arm_controller then holds
         it on activation. All six values are inside the <limit> bounds above. -->
    <joint name="joint_1">
      <command_interface name="position">
        <param name="min">-3.1416</param>
        <param name="max">3.1416</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position">
        <param name="min">-1.7453</param>
        <param name="max">1.9199</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0873</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_3">
      <command_interface name="position">
        <param name="min">-1.0472</param>
        <param name="max">1.1345</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-0.283605</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_4">
      <command_interface name="position">
        <param name="min">-3.49</param>
        <param name="max">3.49</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_5">
      <command_interface name="position">
        <param name="min">-2.0944</param>
        <param name="max">2.0944</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">1.256640</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_6">
      <command_interface name="position">
        <param name="min">-6.9813</param>
        <param name="max">6.9813</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <!-- Pneumatic gripper. Only the left finger's first joint is a real
         driver (position command interface); the other 11 finger joints are
         declared mimic="true" here and carry <mimic> elements in
         irb140_pneumonic_gripper_finger.xacro, so a single
         GripperActionController (config/controllers.yaml: gripper_controller)
         opens/closes both fingers. Mimic joints may only export state
         interfaces. -->
    <joint name="pneumatic_gripper_left_link_1_to_link_2">
      <!-- Software travel limit for the driver joint: -0.0698 ("closed") is
           deliberately kept 0.02 rad inside the -0.09 mechanical joint limit
           (see irb140_pneumonic_gripper_finger.xacro) so a closed gripper is
           resting, not pegged on the hard stop; opening from closed is then
           a free move the weak position gain can complete without stalling. -->
      <command_interface name="position">
        <param name="min">-0.0698</param>
        <param name="max">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint mimic="true" name="pneumatic_gripper_left_link_2_to_link_3">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint mimic="true" name="pneumatic_gripper_left_link_3_to_link_4">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint mimic="true" name="pneumatic_gripper_left_link_4_to_link_5">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint mimic="true" name="pneumatic_gripper_left_link_5_to_link_6">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint mimic="true" name="pneumatic_gripper_left_link_6_to_link_7">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint mimic="true" name="pneumatic_gripper_right_link_1_to_link_2">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint mimic="true" name="pneumatic_gripper_right_link_2_to_link_3">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint mimic="true" name="pneumatic_gripper_right_link_3_to_link_4">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint mimic="true" name="pneumatic_gripper_right_link_4_to_link_5">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint mimic="true" name="pneumatic_gripper_right_link_5_to_link_6">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint mimic="true" name="pneumatic_gripper_right_link_6_to_link_7">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <!-- Brings up a controller_manager inside gz-sim once the entity is spawned.
       The controller config path comes from the controllers_yaml xacro arg
       (see top of file); launch/gazebo.launch.py passes the resolved installed
       path since gz_ros2_control does not evaluate $(find pkg) itself. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/ryan/ros2_ws/install/abb_irb140_description/share/abb_irb140_description/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
