<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="robot_lab">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Robot podium, centered at the world origin. Footprint after the
         model's 0.01 mesh scale is 0.45m x 0.45m, top surface at z=0.97m.
         The irb140 is spawned mounted on top of it by gazebo.launch.py
         (see the spawn_robot_node -z argument there). -->
    <include>
      <uri>model://abb_irb140_description/models/robot_lab_podium</uri>
      <name>robot_lab_podium</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <model name="my_sphere">
      <pose>0.705 0 1.15 0 0 0</pose>
      <link name="sphere_link">
        <!-- Tried and measured to have NO effect: gz-sim's DART-based
             physics (this world's engine) appears not to implement
             <velocity_decay> at all -- a real post-collision rolling ball's
             velocity was numerically identical with and without this tag
             present (~constant deceleration across a 10s window either
             way). It's a Gazebo-Classic/ODE-era SDF element; left here
             (harmless either way) as a note for whoever looks at this next
             rather than something to keep chasing -- see the inertia
             comment above for the other approach that was tried instead
             and reverted for destabilizing the contact solver. Bottom
             line: this engine has no working built-in way found so far to
             make a nudged/rolling ball self-stop in reasonable time; the
             practical mitigation is sim_reset_service.py's respawn_ball
             service (teleport it back rather than wait for physics). -->
        <velocity_decay>
          <linear>0.3</linear>
          <angular>0.3</angular>
        </velocity_decay>
        <!-- Reverted: raising mass to 2.0kg (inertia 0.02) made a grasp
             ATTEMPT catastrophic instead of better -- the gripper fingers'
             CLOSED joint position was apparently already deep enough into
             the original 0.03m-radius ball's collision geometry to cause
             solver interpenetration-correction on contact, and the changed
             mass/inertia turned that from "a few cm of unwanted drift" into
             the ball being launched ~14m away. Back to the original,
             empirically-stable 0.5kg / 0.4 inertia; addressing the
             interpenetration itself instead by shrinking the ball (see the
             collision radius below) rather than changing how it responds
             to being hit. -->
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.4</ixx>
            <iyy>0.4</iyy>
            <izz>0.4</izz>
          </inertia>
        </inertial>
        <!-- Radius shrunk 0.03 -> 0.02m at the user's direction: the
             gripper's fixed CLOSED joint position was apparently already
             deep enough into a 0.03m-radius ball to cause solver
             interpenetration-correction on contact (see the inertial
             comment above -- this is the actual root cause the mass/
             inertia experiment was really fighting). A smaller ball gives
             the closed fingers more clearance, addressing that directly. -->
        <collision name="sphere_collision">
          <geometry>
            <sphere>
              <radius>0.02</radius>
            </sphere>
          </geometry>
          <!-- Without rolling (torsional) friction, gz-physics never damps a
               sphere's spin -- any contact nudge (e.g. a near-miss grasp
               attempt brushing it) sends it rolling indefinitely, since
               plain sliding friction (mu/mu2) alone doesn't resist rolling
               a round shape at all. This is what was causing the ball to
               drift/roll away between pick attempts. -->
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
              <torsional>
                <coefficient>1.0</coefficient>
                <use_patch_radius>true</use_patch_radius>
                <patch_radius>0.02</patch_radius>
              </torsional>
            </friction>
          </surface>
        </collision>
        <visual name="sphere_visual">
          <geometry>
            <sphere>
              <radius>0.02</radius>
            </sphere>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    <!-- Robot lab table, placed in front of the podium (+X, the direction
         the irb140's arm reaches in) with a 20cm gap between the nearest
         faces of the two footprints:
           podium half-depth (0.45m / 2)        = 0.225
           + requested separation                = 0.20
           + table depth (local x: -0.754 to 0)  = 0.754
           = table pose x                        = 1.179 -->
    <include>
      <uri>model://abb_irb140_description/models/robot_lab_table</uri>
      <name>robot_lab_table</name>
      <pose>1.179 0 0 0 0 0</pose>
    </include>

    <!-- hybraut_irb140 hand_eye_calibrate.py's fixed calibration target --
         see models/aruco_calibration_marker/model.sdf. Pose is an estimate
         (table-surface height approximated from my_sphere's resting pose
         above, offset in Y so it doesn't sit under the ball) -- re-check/
         adjust in Gazebo so it actually sits flush on the table surface and
         stays in view across calibration_poses_flat_rad. -->
    <include>
      <uri>model://abb_irb140_description/models/aruco_calibration_marker</uri>
      <name>aruco_calibration_marker</name>
      <pose>0.75 0.15 1.068 0 0 0</pose>
    </include>
  </world>
</sdf>
