<?xml version="1.0"?>
<model>
    <name>ArUco Calibration Marker</name>
    <version>1.0</version>
    <sdf version="1.9">model.sdf</sdf>

    <author>
        <name>Ryan McKee</name>
        <email>ryanmckee47@icloud.com</email>
    </author>

    <description>
        Flat DICT_4X4_50 id=0 ArUco marker, fixed to the table, used as the
        calibration target by hybraut_irb140's hand_eye_calibrate.py. The
        plate is 0.12m (model.sdf) but the detected/measured pattern is only
        its central 0.08m -- the rest is the white quiet-zone margin
        cv2.aruco.detectMarkers requires (see model.sdf's comment). Pass
        marker_length_m:=0.08 to hand_eye_calibrate.py, NOT 0.12. The
        texture (materials/textures/marker_0.png) was generated with
        hybraut_irb140.hand_eye_geometry.generate_marker_image(0); if
        marker_id/aruco_dict_id ever change on the calibration node side,
        regenerate this texture to match.
    </description>
</model>
