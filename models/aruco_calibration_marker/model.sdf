<?xml version="1.0"?>
<!--
  aruco_calibration_marker

  Calibration prerequisite for hybraut_irb140's hand_eye_calibrate.py (see
  that node's module docstring): a flat, static ArUco marker the arm keeps
  in view while sweeping through calibration_poses_flat_rad, so the
  eye-in-hand camera's true tool0 -> depth_camera_optical extrinsic can be
  measured against a fixed, known target rather than assumed from the
  xacro's nominal mount-joint constants.

  NOT visually verified in a running Gazebo session as part of this change
  (added alongside the calibration node itself) -- check in RViz/Gazebo
  after including this model that the marker.png texture actually renders
  on the top face before relying on it; gz-sim's PBR albedo-map path/UV
  behaviour can be finicky across versions. If the texture doesn't show up,
  the <material><ambient>/<diffuse> fallback below at least renders a
  plain white square, and cv2.aruco's own detector will still need the
  real printed marker for the physical robot regardless.
-->
<sdf version="1.9">
  <model name="aruco_calibration_marker">
    <static>true</static>
    <link name="marker_link">
      <!-- marker_0.png (generated by hand_eye_geometry.generate_marker_image)
           is the black-bordered pattern PLUS a 25% white quiet-zone margin
           on each side (required for cv2.aruco.detectMarkers to find it at
           all - confirmed by direct test that the bare pattern with no
           margin is never detected). So this plate's full size is
           marker_length_m * 1.5, NOT marker_length_m itself -- only the
           central 0.08m of it is the actual detected/measured pattern.
           hand_eye_calibrate.py's marker_length_m param must be set to
           0.08m (the inner pattern size), not this plate's 0.12m. -->
      <visual name="marker_visual">
        <geometry>
          <box>
            <size>0.12 0.12 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/marker_0.png</albedo_map>
              <roughness>0.8</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="marker_collision">
        <geometry>
          <box>
            <size>0.12 0.12 0.002</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
