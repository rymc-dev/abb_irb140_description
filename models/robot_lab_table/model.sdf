<?xml version="1.0"?>
<sdf version="1.9">
  <model name="robot_lab_table">
    <static>true</static>
    <link name="base_link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>mesh/robot_lab_table.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.95 0.92 0.80 1</ambient>
          <diffuse>0.95 0.92 0.80 1</diffuse>
          <specular>0.3 0.3 0.28 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>mesh/robot_lab_table.stl</uri>
          </mesh>
        </geometry>
        <!-- Explicit friction (including torsional/rolling), matching
             my_sphere's collision surface in robot_lab.world -- a contact's
             combined friction otherwise falls back to whatever the engine's
             defaults are for whichever side leaves it unset, which is what
             let a nudged ball (e.g. from a near-miss grasp) roll away
             indefinitely instead of settling. -->
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
            <torsional>
              <coefficient>1.0</coefficient>
            </torsional>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
